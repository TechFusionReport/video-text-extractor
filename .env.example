EXTRACTOR_API_KEY=replace-with-a-long-random-secret
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_MEDIA_SECONDS=3600
JOB_TIMEOUT_SECONDS=1800
# Browser impersonation reduces blocking on datacenter IPs. Use an available
# target from `yt-dlp --list-impersonate-targets`, or leave blank to disable.
YT_DLP_IMPERSONATE_TARGET=chrome
# Optional Netscape-format cookie file for sources that require authentication.
# Mount it read-only into the container and set its in-container path here.
# YT_DLP_COOKIE_FILE=/run/secrets/yt-dlp-cookies.txt
# OCR samples video frames locally and returns visible on-screen text.
OCR_ENABLED=true
OCR_FRAME_INTERVAL_SECONDS=2
OCR_MAX_FRAMES=180
OCR_MIN_CONFIDENCE=0.55
