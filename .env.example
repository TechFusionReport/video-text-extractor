EXTRACTOR_API_KEY=replace-with-a-long-random-secret
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_MEDIA_SECONDS=3600
JOB_TIMEOUT_SECONDS=1800
# Browser impersonation reduces blocking on datacenter IPs. Use an available
# target from `yt-dlp --list-impersonate-targets`, or leave blank to disable.
YT_DLP_IMPERSONATE_TARGET=chrome
# Optional Netscape-format cookie file for sources that require authentication.
# Mount it read-only into the container and set its in-container path here.
# YT_DLP_COOKIE_FILE=/run/secrets/yt-dlp-cookies.txt
# OCR is opt-in twice: this switch must be true AND the request must send "ocr": true.
# It downloads the whole video, so it is skipped for media longer than OCR_MAX_MEDIA_SECONDS.
OCR_ENABLED=false
OCR_MAX_MEDIA_SECONDS=600
OCR_FRAME_INTERVAL_SECONDS=2
OCR_MAX_FRAMES=180
OCR_MIN_CONFIDENCE=0.55
# Whisper (no-captions fallback) refuses media longer than this many seconds.
WHISPER_MAX_MEDIA_SECONDS=1800
# Parallel extraction jobs; extra requests wait QUEUE_TIMEOUT_SECONDS then get 503 + Retry-After.
MAX_CONCURRENT_JOBS=2
QUEUE_TIMEOUT_SECONDS=30
